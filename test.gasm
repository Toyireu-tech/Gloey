jump _start

#alias data_offset 0x1FF

; use: blit <x> <y> <data offset>
.section blit   
    #alias arg_x r1
    #alias arg_y r2
    #alias arg_data r3

    #alias width r6
    #alias height r7
    #alias cursor r8

    #alias h_i r9
    #alias w_i r10
    #alias color r11

    #alias target_x r12
    #alias target_y r13
    
    load $h_i 0
    load $w_i 0

    copy $cursor $arg_data

    memgw $width $cursor ; load the width
    addi $cursor $cursor 4
    memgw $height $cursor ; load the height
    addi $cursor $cursor 4

    .label h_loop
        comp $h_i $height
        jeq end_blit          ; si h_i == height dès le départ (donc height=0), on sort direct

        load $w_i 0
        .label w_loop
            comp $w_i $width
            jeq end_w_loop      ; si w_i == width dès le départ, on sort direct

            add $target_x $arg_x $w_i
            add $target_y $arg_y $h_i
            memgw $color $cursor
            setpix $target_x $target_y $color
            addi $cursor $cursor 4

            addi $w_i $w_i 1
            jump w_loop
        .label end_w_loop

        addi $h_i $h_i 1
        jump h_loop
.label end_blit

ret

.label _start
    load r1 100
    load r2 100
    load r3 sprite
    call blit

halt


.label sprite
    .incbin "a.bin"